# Doxyfile — TIVIDY project configuration

# ---------- Project info ----------
PROJECT_NAME           = "TIVIDY"
PROJECT_BRIEF          = "Workflow Management System (COS214 Project)"
PROJECT_NUMBER         = "1.0"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English

# ---------- Input ----------
INPUT                  = include src tests
FILE_PATTERNS          = *.h *.cpp *.hpp
RECURSIVE              = YES
EXCLUDE                = build docs
EXCLUDE_PATTERNS       = */build/* */docs/*

# ---------- Output formats ----------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

# ---------- Parsing behaviour ----------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# ---------- Warnings ----------
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = NO

# ---------- C++ specific ----------
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
EXTRACT_ANON_NSPACES   = NO
DISTRIBUTE_GROUP_DOC   = YES
SUBGROUPING            = YES

# ---------- Preprocessing ----------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include
INCLUDE_FILE_PATTERNS  = *.h

# ---------- Diagrams (requires graphviz) ----------
HAVE_DOT               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = png
DOT_GRAPH_MAX_NODES    = 50

# ---------- Search & Navigation ----------
SEARCHENGINE           = YES
GENERATE_TREEVIEW      = YES

# ---------- Source browsing ----------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ---------- HTML appearance ----------
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_TIMESTAMP         = YES
HTML_DYNAMIC_SECTIONS  = YES